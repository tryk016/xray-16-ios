<?xml version="1.0" encoding="UTF-8"?>
<!-- iOS Info.plist for the xr_3da app bundle. Generated by CMake (configure_file @ONLY)
     from src/xr_3da/CMakeLists.txt on iOS. Carries the keys SideStore/AltStore and iOS
     require to install and launch an unsigned sideloaded app. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>@XR_IOS_EXECUTABLE@</string>
    <key>CFBundleIdentifier</key>
    <string>@XR_IOS_BUNDLE_ID@</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>@XR_IOS_EXECUTABLE@</string>
    <key>CFBundleDisplayName</key>
    <string>@XR_IOS_DISPLAY_NAME@</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundleShortVersionString</key>
    <string>@XR_IOS_SHORT_VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@XR_IOS_BUILD_VERSION@</string>
    <key>CFBundleSupportedPlatforms</key>
    <array>
        <string>iPhoneOS</string>
    </array>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>MinimumOSVersion</key>
    <string>@XR_IOS_MIN_OS@</string>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
        <key>UISceneConfigurations</key>
        <dict>
            <key>UIWindowSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneClassName</key>
                    <string>UIWindowScene</string>
                    <key>UISceneConfigurationName</key>
                    <string>OpenXRayScene</string>
                    <key>UISceneDelegateClassName</key>
                    <string>SDLUIKitSceneDelegate</string>
                </dict>
            </array>
        </dict>
    </dict>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <!-- Empty dict = system default launch screen (satisfies the launch-storyboard
         requirement without a xib/storyboard asset; real one is a later polish step). -->
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UIStatusBarHidden</key>
    <true/>
    <key>UIRequiresFullScreen</key>
    <true/>
    <!-- Expose the app's Documents folder (engine log + writable state) in the Files app
         and over USB, so device logs can be pulled without a debugger. -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
    <!-- iOS 18+ Game Mode: sustained CPU/GPU priority, reduced background activity, and
         lower Bluetooth latency for controllers/audio while the game is frontmost. The
         games category + the Game Mode opt-in key are what the system keys off. -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.games</string>
    <!-- iOS 18.6 deprecated GCSupportsGameMode in favor of LSSupportsGameMode; modern iOS
         (incl. 26.x) keys off the LS variant, and Apple warns Game Mode "might not turn
         on" without it. Keep the GC variant too for iOS 18.0-18.5 installs. -->
    <key>LSSupportsGameMode</key>
    <true/>
    <key>GCSupportsGameMode</key>
    <true/>
    <key>GCSupportsControllerUserInteraction</key>
    <true/>
</dict>
</plist>
