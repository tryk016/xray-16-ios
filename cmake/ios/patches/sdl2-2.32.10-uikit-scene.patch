+
+static BOOL SDL_ClaimMainRun(void)
+{
+    __block BOOL claimed = NO;
+    dispatch_once(&forward_main_once, ^{
+        claimed = YES;
+    });
+    return claimed;
+}
+
+/* Claim once, then leave dispatch_once before SDL_main starts pumping UIKit. */
+static void SDL_RunMainOnce(void)
+{
+    if (!SDL_ClaimMainRun()) {
+        return;
+    }
+    SDL_iPhoneSetEventPump(SDL_TRUE);
+    exit_status = forward_main(forward_argc, forward_argv);
+    SDL_iPhoneSetEventPump(SDL_FALSE);
+}
 
