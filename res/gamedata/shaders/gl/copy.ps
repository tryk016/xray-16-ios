#include "common.h"

#ifndef ISAMPLE
#define ISAMPLE uint(0)
#endif

#ifdef MSAA_OPTIMIZATION
#ifndef GL_ES
in int gl_SampleID;
#endif
#endif
out vec4 SV_Target;

VARYING(TEXCOORD0) in float4 xrvary8;

//////////////////////////////////////////////////////////////////////////////////////////
// Pixel
void main ()
{
	//return	tex2D		(s_base,xrvary8.xy);
#ifndef USE_MSAA
	SV_Target	=	tex2D		( s_generic, xrvary8.xy );
#else
#ifndef MSAA_OPTIMIZATION
	SV_Target	=	texelFetch	( s_generic, int2( xrvary8.xy * pos_decompression_params2.xy), ISAMPLE );
#else
	SV_Target	=	texelFetch	( s_generic, int2( xrvary8.xy * pos_decompression_params2.xy), gl_SampleID );
#endif
#endif
}
