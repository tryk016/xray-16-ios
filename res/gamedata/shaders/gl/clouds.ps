#include "common.h"
#ifdef GL_ES
// Vertex-stage texelFetch of s_tonemap (VTF) returns 0 on the ES monolithic
// path (vertex-sampler binding) — the sky/clouds pre-scaled to black. Use the
// non-VTF path: tonemap sampled in the fragment stage, like the combine pass.
#undef USE_VTF
#endif
#include "iostructs\p_clouds.h"

Texture2D	s_clouds0;
Texture2D	s_clouds1;

//////////////////////////////////////////////////////////////////////////////////////////
// Pixel
float4 	_main	( v2p I )
{
	float4 	s0_0	=	tex2D(s_clouds0, I.tc0);
	float4 	s0_1	=	tex2D(s_clouds1, I.tc0);
	float4 	s1_0	=	tex2D(s_clouds0, I.tc1);
	float4 	s1_1	=	tex2D(s_clouds1, I.tc1);
	float4 	s_0	=	(s0_0 + s1_0);
	float4 	s_1	=	(s0_1 + s1_1);
	float4 	mix	=	I.color * lerp(s_0, s_1, L_ambient.w);

#ifdef USE_VTF
	return  mix;
#else // USE_VTF
	float4 result, high;

	float scale	=	tex2D(s_tonemap, float2(0.5,0.5)).x;
	tonemap			(result, high, mix.rgb, scale);

	result.a	= mix.a;

	return	result;
#endif // USE_VTF
}
