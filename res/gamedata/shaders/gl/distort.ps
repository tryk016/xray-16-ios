#include "common.h"

out vec4 SV_Target;

VARYING(TEXCOORD0) in float2 xrvary8;

uniform sampler2D 	s_distort;

//////////////////////////////////////////////////////////////////////////////////////////
// Pixel
void main ()
{
	float2 distort	= tex2D(s_distort, xrvary8).xy;
	float2 offset	= (distort-0.5)*def_distort;
	offset.y		*= -1.0;
	float3 image	= tex2D(s_base, xrvary8 + offset).rgb;

	// out
	SV_Target		= float4 (image, 1.0);					// +mov
}
